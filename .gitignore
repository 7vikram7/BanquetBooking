# Build output — regenerated on every deploy from src/ (see firebase.json's
# hosting predeploy script). Never hand-edited, never committed.
public/

# Firebase CLI local cache/hosting metadata.
.firebase/

# Cloud Functions dependencies (functions/package.json is committed;
# functions/node_modules is not — see functions/.gitignore too).
node_modules/

# Emulator debug logs.
*-debug.log
firebase-debug.*.log

# OS/editor cruft.
.DS_Store
Thumbs.db
~$*.xlsx

# Service account / credential keys — these must NEVER be committed. Real
# deploy credentials for this project live outside the repo entirely (see
# CONTEXT.md's deployment section), but these patterns are a defense-in-depth
# net in case one is ever dropped in here by mistake (as one was, briefly,
# before being caught and moved — see git history / project memory).
*-service-account*.json
*-adminsdk-*.json
saga-banquet-enquiry-*.json
*.pem
*.key
